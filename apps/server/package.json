{
	"name": "@metal/server",
	"version": "0.4.0",
	"license": "GPL-3.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": "=24.13.0"
	},
	"scripts": {
		"server": "yarn server:build && yarn server:start",
		"server:start": "node dist/index.js",
		"server:build-all-images": "yarn build && node dist/index.js --build-all-images",
		"server:generate-api-key": "yarn build && node dist/index.js --generate-api-key",
		"server:build": "tsup-node",
		"dev": "tsx watch --inspect=0.0.0.0:9229 src/index.ts",
		"dev:build:watch": "tsc --watch",
		"dev:generate-api-key": "tsx watch --inspect=0.0.0.0:9229 src/index.ts --generate-api-key",
		"dev:build-all-images": "tsx watch --inspect=0.0.0.0:9229 src/index.ts --build-all-images",
		"dev:test": "vitest run --project @metal/server",
		"dev:lint": "biome lint --write src",
		"dev:lint:check": "biome lint src",
		"dev:format": "biome format --write src",
		"dev:format:check": "biome format src",
		"dev:check": "biome check src",
		"dev:tools:unused-modules": "madge --circular --extensions ts src --orphans --exclude __tests__",
		"dev:tools:dependency-graph": "npx madge --circular --extensions ts src -i circular.png --exclude __tests__",
		"dev:release": "standard-version",
		"dev:release:dry": "standard-version --dry-run --skip.commit --skip.tag",
		"dev:release:minor": "standard-version --release-as minor",
		"dev:release:major": "standard-version --release-as major"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1062.0",
		"@azure/cosmos": "^4.9.3",
		"@azure/storage-blob": "^12.32.0",
		"@azure/storage-file-datalake": "^12.30.0",
		"@azure/storage-file-share": "^12.31.0",
		"@dimkl/events": "^3.0.3",
		"@duckdb/node-api": "^1.5.3-r.3",
		"@metal/config": "workspace:*",
		"@metal/logger": "workspace:*",
		"@metal/persistent-map": "workspace:*",
		"@metal/types": "workspace:*",
		"@metal/utils": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@synatic/noql": "^6.0.6",
		"argparse": "^3.0.0",
		"axios": "^1.17.0",
		"basic-ftp": "^6.0.1",
		"bcryptjs": "^3.0.3",
		"bytes": "^3.1.2",
		"chokidar": "^5.0.0",
		"compression": "^1.8.1",
		"cron": "^4.4.0",
		"csv-parse": "^6.2.1",
		"csv-stringify": "^6.7.0",
		"dockerode": "^5.0.0",
		"dotenv": "^17.4.2",
		"exceljs": "^4.4.0",
		"express": "^5.2.1",
		"express-openapi-validator": "^5.6.2",
		"express-rate-limit": "^8.5.2",
		"fast-xml-parser": "^5.8.0",
		"file-type": "^22.0.1",
		"helmet": "^8.2.0",
		"hyparquet": "^1.26.0",
		"hyparquet-writer": "^0.15.6",
		"js-sha512": "^0.9.0",
		"js-yaml": "^4.2.0",
		"jsonwebtoken": "^9.0.3",
		"lodash-es": "^4.18.1",
		"loglevel": "^1.9.2",
		"mime-types": "^3.0.2",
		"mongodb": "^7.2.0",
		"mssql": "^12.5.5",
		"mysql2": "^3.22.4",
		"openid-client": "~6.8.4",
		"pg": "^8.21.0",
		"response-time": "^2.3.4",
		"soap": "^1.9.3",
		"ssh2-sftp-client": "^12.1.1",
		"swagger-ui-express": "^5.0.1",
		"ts-mixer": "^6.0.4",
		"uuidv7": "^1.2.1",
		"vm2": "^3.11.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@swc/core": "^1.15.41",
		"@types/bytes": "^3.1.5",
		"@types/compression": "^1.8.1",
		"@types/dockerode": "^4.0.1",
		"@types/express": "^5.0.6",
		"@types/js-yaml": "^4.0.9",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/lodash-es": "^4.17.12",
		"@types/mime-types": "^3.0.1",
		"@types/mssql": "^12.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.20.0",
		"@types/response-time": "^2.3.9",
		"@types/ssh2-sftp-client": "^9.0.6",
		"@types/swagger-ui-express": "^4.1.8",
		"madge": "^8.0.0",
		"standard-version": "^9.5.0",
		"tsup": "^8.5.1",
		"tsx": "^4.22.4",
		"typescript": "~6.0.3"
	}
}
