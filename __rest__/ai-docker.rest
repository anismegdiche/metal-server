# @name huggingface
# Base URL
@baseUrl = http://localhost:5000/huggingface
@textUrl = http://localhost:5001/huggingface/text

# Common variables
@car1 = car1.jpg
@photo1 = photo2.jpeg
@audioFile = harvard.wav 
#@audioFile = angry-man.wav 
@videoFile = globe.mp4

### Health Check
GET {{textUrl}}/health

### List All Tasks
GET {{textUrl}}/tasks

### 1. TEXT TASKS

### @name sentiment-analysis
POST {{textUrl}}/sentiment-analysis
Content-Type: application/json

{
    "input_data": "I love using this service!",
    "params": {
        "top_k": null
    }
}

