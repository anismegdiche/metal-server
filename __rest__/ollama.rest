@baseUrl = http://127.0.0.1:11011

# ── Health Check ─────────────────────────────────────────

# @name health
GET {{baseUrl}}/api/tags

###

# ── Completion (OpenAI-compatible) ───────────────────────

# @name completion
POST {{baseUrl}}/v1/chat/completions
Content-Type: application/json

{
    "model": "llama3-groq-tool-use:8b",
    "messages": [
        { "role": "user", "content": "Hello, what can you do?" }
    ],
    "temperature": 0.7,
    "max_tokens": 256
}

###

# ── Tool-use example ─────────────────────────────────────

# @name completionTool
POST {{baseUrl}}/v1/chat/completions
Content-Type: application/json

{
    "model": "llama3-groq-tool-use:8b",
    "messages": [
        { "role": "user", "content": "What is 2 + 2?" }
    ],
    "tools": [
        {
            "type": "function",
            "function": {
                "name": "calculator",
                "description": "Perform arithmetic",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "expression": { "type": "string" }
                    },
                    "required": ["expression"]
                }
            }
        }
    ],
    "temperature": 0.0,
    "max_tokens": 128
}

