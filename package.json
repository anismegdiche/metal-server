    "@babel/preset-env": "~7.26.9",
    "@babel/preset-typescript": "~7.26.0",
    "@eslint/eslintrc": "~3.3.0",
    "@eslint/js": "~9.21.0",
    "@jest/globals": "^29.7.0",
    "@types/chalk": "~2.2.4",
    "@types/cron": "~2.4.3",
    "@types/express": "~5.0.0",
    "@types/fs-extra": "~11.0.4",
    "@types/jest": "~29.5.14",
    "@types/js-yaml": "~4.0.9",
