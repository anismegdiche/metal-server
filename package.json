    "@azure/storage-file-share": "^12.27.0",
    "@synatic/noql": "^5.0.1",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "alasql": "^4.6.6",
    "axios": "^1.8.4",
    "basic-ftp": "^5.0.5",
    "bcryptjs": "^3.0.2",
    "bytes": "^3.1.2",
    "chokidar": "^4.0.3",
    "chrono-node": "^2.8.0",
    "colorette": "^2.0.20",
    "cron": "^4.1.4",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-openapi-validator": "^5.4.8",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "fast-xml-parser": "^5.2.0",
    "helmet": "^8.1.0",
    "jimp": "^0.22.12",
    "js-sha512": "^0.9.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "mongodb": "^6.15.0",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.14.0",
    "node-nlp": "^4.27.0",
    "object-path": "^0.11.8",
    "openid-client": "^5.7.1",
    "papaparse": "^5.5.2",
    "pg": "^8.14.1",
    "response-time": "^2.3.3",
    "safe-stable-stringify": "^2.5.0",
    "smb2": "^0.2.11",
    "soap": "^1.1.10",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^6.0.1",
    "ts-mixer": "^6.0.4",
    "typia": "^9.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@jest/globals": "^29.7.0",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
