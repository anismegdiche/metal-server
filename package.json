    "@types/jsonstream": "~0.8.33",
    "alasql": "~4.6.4",
    "axios": "~1.8.2",
    "basic-ftp": "~5.0.5",
    "bcryptjs": "^3.0.2",
    "bytes": "~3.1.2",
    "chalk": "~4.1.2",
    "chokidar": "~4.0.3",
    "chrono-node": "~2.7.8",
    "cron": "~4.1.0",
    "exceljs": "~4.4.0",
    "express": "~4.21.2",
    "express-openapi-validator": "~5.4.6",
    "express-rate-limit": "~7.5.0",
    "express-validator": "~7.2.1",
    "fast-xml-parser": "~5.0.8",
    "helmet": "^8.0.0",
    "jimp": "~0.22.12",
    "js-sha512": "~0.9.0",
    "js-yaml": "~4.1.0",
    "jsonwebtoken": "~9.0.2",
    "lodash": "~4.17.21",
    "loglevel": "~1.9.2",
    "loglevel-plugin-prefix": "~0.8.4",
    "mongodb": "~6.14.2",
    "morgan": "~1.10.0",
    "mssql": "~11.0.1",
    "mysql2": "~3.13.0",
    "node-nlp": "~4.27.0",
    "object-path": "^0.11.8",
    "openid-client": "~5.7.1",
    "papaparse": "~5.5.2",
