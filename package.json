{
  "engines": {
    "node": "=22.13.0"
  },
  "name": "metal",
  "version": "0.4.0",
  "description": "Metal Server",
  "author": "Anis Megdiche",
  "license": "GPL-3.0-or-later",
  "main": "./build/index.js",
  "scripts": {
    "prod": "node ./build/index.js",
    "dev": "nodemon --exec \"npm run _prod-ts\" --watch src/",
    "build": "tsc --watch",
    "test": "jest --testMatch \"**/__tests__/*.test.ts\"",
    "test-e2e": "jest --testMatch \"**/client/__tests__/**/*.js\"",
    "test-docker": "docker compose run --rm metal npx jest --testMatch \"**/__tests__/*.test.ts\" --watchAll",
    "prepare": "ts-patch install",
    "release": "semantic-release",
    "dev-lint": "eslint --fix src",
    "dev-changelog": "git --no-pager log --since=\"2024-12-15\" --oneline --pretty=format:\"- %s\" > HISTORY.md",
    "_prod-ts": "ts-node ./src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@azure/cosmos": "^4.3.0",
    "@azure/storage-blob": "^12.27.0",
