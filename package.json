{
    "engines": {
        "node": "=22.13.0"
    },
    "name": "metal",
    "version": "0.4.0",
    "description": "Metal Server",
    "author": "Anis Megdiche",
    "license": "GPL-3.0-or-later",
    "main": "./build/index.js",
    "scripts": {
        "prod": "node ./build/index.js",
        "prod-ts": "ts-node ./src/index.ts",
        "dev": "nodemon --exec \"npm run dev-ts\" --watch src/**/*",
        "dev-ts": "ts-node-dev --inspect=0.0.0.0:9229 ./src/index.ts",
        "build": "tsc --watch",
        "test": "jest --testMatch \"**/__tests__/*.test.ts\"",
        "test-e2e": "jest --testMatch \"**/client/__tests__/**/*.js\"",
        "test-docker": "docker compose run --rm metal npx jest --testMatch \"**/__tests__/*.test.ts\" --watchAll",
        "prepare": "ts-patch install",
        "release": "standard-version",
        "release:dry": "standard-version --dry-run --skip.commit --skip.tag",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "lint": "eslint --fix src",
        "pretty": "dprint fmt src/**",
        "check": "npm run lint && npm run pretty",
        "dev-changelog": "git --no-pager log --since=\"2024-12-15\" --oneline --pretty=format:\"- %s\" > HISTORY.md",
        "dev-dep-circular": "madge --circular --image graph.svg .\\src\\index.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.812.0",
        "@azure/cosmos": "^4.4.1",
        "@azure/storage-blob": "^12.27.0",
        "@azure/storage-file-datalake": "^12.26.0",
        "@azure/storage-file-share": "^12.27.0",
        "@loxjs/url-join": "^1.0.2",
        "@synatic/noql": "^5.0.1",
        "alasql": "^4.6.6",
        "axios": "^1.9.0",
        "basic-ftp": "^5.0.5",
        "bcryptjs": "^3.0.2",
        "bytes": "^3.1.2",
        "chokidar": "^4.0.3",
        "chrono-node": "^2.8.0",
        "colorette": "^2.0.20",
        "cron": "^4.3.0",
        "dockerode": "^4.0.6",
        "dotenv": "^16.5.0",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "express-openapi-validator": "^5.5.1",
        "express-rate-limit": "^7.5.0",
        "express-validator": "^7.2.1",
        "fast-xml-parser": "^5.2.3",
        "file-type": "^20.5.0",
        "helmet": "^8.1.0",
        "import-lazy": "^4.0.0",
        "jimp": "^0.22.12",
        "js-sha512": "^0.9.0",
        "js-yaml": "^4.1.0",
        "jsonwebtoken": "^9.0.2",
        "load-esm": "^1.0.2",
        "lodash": "^4.17.21",
        "loglevel": "^1.9.2",
        "loglevel-plugin-prefix": "^0.8.4",
        "mime-types": "^3.0.1",
        "mongodb": "^6.16.0",
        "morgan": "^1.10.0",
        "mssql": "^11.0.1",
        "mysql2": "^3.14.1",
        "object-path": "^0.11.8",
        "openid-client": "^5.7.1",
        "papaparse": "^5.5.2",
        "pg": "^8.16.0",
        "response-time": "^2.3.3",
        "safe-stable-stringify": "^2.5.0",
        "soap": "^1.1.11",
        "swagger-ui-express": "^5.0.1",
        "ts-mixer": "^6.0.4",
        "typia": "^9.7.1"
    },
    "devDependencies": {
        "@babel/core": "^7.27.1",
        "@babel/preset-env": "^7.27.2",
        "@babel/preset-typescript": "^7.27.1",
        "@eslint/js": "^9.34.0",
        "@jest/globals": "^29.7.0",
        "@types/cron": "^2.4.3",
        "@types/dockerode": "^3.3.39",
        "@types/express": "^5.0.2",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^29.5.14",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonstream": "^0.8.33",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/lodash": "^4.17.16",
        "@types/mime-types": "^2.1.4",
        "@types/morgan": "^1.9.9",
        "@types/mssql": "^9.1.7",
        "@types/node": "^22.15.32",
        "@types/object-path": "^0.11.4",
        "@types/offscreencanvas": "^2019.7.3",
        "@types/papaparse": "^5.3.16",
        "@types/pg": "^8.15.2",
        "@types/response-time": "^2.3.8",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "babel-jest": "^29.7.0",
        "crc-32": "^1.2.2",
        "dprint": "^0.49.1",
        "eslint": "^9.34.0",
        "eslint-plugin-lodash": "^8.0.0",
        "eslint-plugin-security": "^3.0.1",
        "eslint-plugin-unused-imports": "^4.2.0",
        "eslint-plugin-you-dont-need-lodash-underscore": "^6.14.0",
        "form-data": "^4.0.3",
        "fs-extra": "^11.3.0",
        "globals": "^16.3.0",
        "jest": "^29.7.0",
        "madge": "^8.0.0",
        "nodemon": "^3.1.10",
        "standard-version": "^9.5.0",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "ts-patch": "^3.3.0",
        "tslib": "^2.8.1",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.42.0"
    },
    "standard.options": {
        "ignore": [
            "node_modules/**",
            "build/**",
            "*.vscode*"
        ]
    },
    "standard-version": {
        "noVerify": true,
        "commitAll": false
    }
}
