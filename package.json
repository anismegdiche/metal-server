{
    "engines": {
        "node": "=24.13.0"
    },
    "name": "metal",
    "version": "0.4.0",
    "description": "Metal Server",
    "author": "Anis Megdiche",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --inspect=0.0.0.0:9229 src/index.ts",
        "dev:build-all-images": "tsx watch --inspect=0.0.0.0:9229 src/index.ts --build-all-images",
        "build": "tsup-node",
        "build:watch": "tsc --watch",
        "start": "node dist/index.js",
        "prod": "npm run build && npm run start",
        "prod:build-all-images": "npm run build && node dist/index.js --build-all-images",
        "test": "vitest run",
        "lint": "biome lint --write src",
        "lint:check": "biome lint src",
        "format": "biome format --write src",
        "format:check": "biome format src",
        "check": "biome check src",
        "prepare": "echo \"prepare done.\"",
        "release": "standard-version",
        "release:dry": "standard-version --dry-run --skip.commit --skip.tag",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as madejor",
        "tools:unused-modules": "madge --circular --extensions ts src --orphans --exclude __tests__",
        "tools:dependency-graph": "npx madge --circular --extensions ts src -i circular.png --exclude __tests__"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1000.0",
        "@azure/cosmos": "^4.9.1",
        "@azure/storage-blob": "^12.30.0",
        "@azure/storage-file-datalake": "^12.29.0",
        "@azure/storage-file-share": "^12.30.0",
        "@duckdb/duckdb-wasm": "^1.32.0",
        "@duckdb/node-api": "^1.4.4-r.2",
        "@loxjs/url-join": "^1.0.2",
        "@synatic/noql": "^5.1.0",
        "@types/lodash-es": "^4.17.12",
        "alasql": "^4.17.0",
        "axios": "^1.13.4",
        "basic-ftp": "^5.2.0",
        "bcryptjs": "^3.0.3",
        "bytes": "^3.1.2",
        "chokidar": "^5.0.0",
        "chrono-node": "^2.9.0",
        "colorette": "^2.0.20",
        "cron": "^4.4.0",
        "csv": "^6.4.1",
        "dockerode": "^4.0.9",
        "dotenv": "^17.3.1",
        "duckdb": "^1.4.4",
        "duckdb-async": "^1.4.2",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "express-openapi-validator": "^5.6.2",
        "express-rate-limit": "^8.2.1",
        "fast-deep-equal": "^3.1.3",
        "fast-xml-parser": "^5.4.1",
        "file-type": "^21.3.0",
        "helmet": "^8.1.0",
        "hyparquet": "^1.25.1",
        "hyparquet-writer": "^0.13.0",
        "js-sha512": "^0.9.0",
        "js-yaml": "^4.1.1",
        "jsonwebtoken": "^9.0.3",
        "lodash-es": "^4.17.23",
        "loglevel": "^1.9.2",
        "loglevel-plugin-prefix": "^0.8.4",
        "mime-types": "^3.0.2",
        "mongodb": "^7.0.0",
        "morgan": "^1.10.1",
        "mssql": "^12.2.0",
        "mysql2": "^3.18.2",
        "object-path": "^0.11.8",
        "openid-client": "~5.7.0",
        "pg": "^8.19.0",
        "response-time": "^2.3.4",
        "safe-stable-stringify": "^2.5.0",
        "soap": "^1.7.1",
        "ssh2-sftp-client": "^12.0.1",
        "swagger-ui-express": "^5.0.1",
        "ts-mixer": "^6.0.4",
        "uuidv7": "^1.1.0",
        "vm2": "^3.10.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.7",
        "@types/bytes": "^3.1.5",
        "@types/cron": "^2.4.3",
        "@types/dockerode": "^4.0.1",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonstream": "^0.8.33",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mime-types": "^3.0.1",
        "@types/morgan": "^1.9.10",
        "@types/mssql": "^9.1.9",
        "@types/node": "^25.3.3",
        "@types/object-path": "^0.11.4",
        "@types/offscreencanvas": "^2019.7.3",
        "@types/pg": "^8.18.0",
        "@types/response-time": "^2.3.9",
        "@types/ssh2-sftp-client": "^9.0.6",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@vitest/coverage-v8": "^4.0.18",
        "crc-32": "^1.2.2",
        "dprint": "^0.52.0",
        "form-data": "^4.0.5",
        "fs-extra": "^11.3.3",
        "globals": "^17.4.0",
        "madge": "^8.0.0",
        "standard-version": "^9.5.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "vitest": "^4.0.18"
    },
    "standard.options": {
        "ignore": [
            "node_modules/**",
            "build/**",
            "*.vscode*"
        ]
    },
    "standard-version": {
        "noVerify": true,
        "commitAll": false
    }
}
