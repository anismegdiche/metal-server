  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup-node",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "prod": "npm run build && npm run start",
    "test": "vitest",
    "lint": "eslint --fix src",
    "pretty": "dprint fmt src/**",
