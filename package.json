{
	"name": "metal",
	"version": "0.4.0",
	"description": "Metal Server",
	"author": "Anis Megdiche",
	"license": "GPL-3.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.16.0"
	},
	"scripts": {
		"server": "yarn workspace @metal/server server",
		"server:build-ai-images": "yarn workspace @metal/server server:build-ai-images",
		"server:generate-api-key": "yarn workspace @metal/server server:generate-api-key",
		"studio": "yarn workspace @metal/studio studio",
		"example:ai-chat:dev": "cd examples/ai-chat && yarn dev",
		"build:server": "yarn workspaces foreach --from @metal/server -Rt run build",
		"build:all": "yarn workspaces foreach -A run build"
	},
	"standard.options": {
		"ignore": [
			"node_modules/**",
			"build/**",
			"*.vscode*"
		]
	},
	"standard-version": {
		"noVerify": true,
		"commitAll": false
	},
	"devDependencies": {
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.10",
		"vitest": "^4.1.10"
	},
	"packageManager": "yarn@4.17.1",
	"workspaces": [
		"apps/*",
		"packages/*",
		"docs"
	]
}
