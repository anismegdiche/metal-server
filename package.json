{
	"engines": {
		"node": "=24.13.0"
	},
	"name": "metal",
	"version": "0.4.0",
	"description": "Metal Server",
	"author": "Anis Megdiche",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "yarn workspace @metal/server dev",
		"studio:dev": "yarn workspace studio dev",
		"example:ai-chat:dev": "cd examples/ai-chat && yarn dev",
		"dev:build-all-images": "yarn workspace @metal/server dev:build-all-images",
		"build": "yarn workspace @metal/server build",
		"build:watch": "yarn workspace @metal/server build:watch",
		"build:workspaces": "yarn workspaces foreach -A run build",
		"start": "yarn workspace @metal/server start",
		"prod": "yarn workspace @metal/server prod",
		"prod:build-all-images": "yarn workspace @metal/server prod:build-all-images",
		"prod:generate-api-key": "yarn workspace @metal/server prod:generate-api-key",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:server": "vitest run --project @metal/server",
		"test:types": "vitest run --project @metal/types",
		"test:logger": "vitest run --project @metal/logger",
		"lint": "yarn workspace @metal/server lint",
		"lint:check": "yarn workspace @metal/server lint:check",
		"format": "yarn workspace @metal/server format",
		"format:check": "yarn workspace @metal/server format:check",
		"check": "yarn workspace @metal/server check",
		"prepare": "echo \"prepare done.\"",
		"tools:unused-modules": "yarn workspace @metal/server tools:unused-modules",
		"tools:dependency-graph": "yarn workspace @metal/server tools:dependency-graph"
	},
	"standard.options": {
		"ignore": [
			"node_modules/**",
			"build/**",
			"*.vscode*"
		]
	},
	"standard-version": {
		"noVerify": true,
		"commitAll": false
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@vitest/coverage-v8": "^4.1.8",
		"vitest": "^4.1.9"
	},
	"packageManager": "yarn@4.17.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
