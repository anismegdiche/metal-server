    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  },
  "standard.options": {
    "ignore": [
      "node_modules/**",
      "build/**",
      "*.vscode*"
    ]
  },
  "standard-version": {
    "noVerify": true,
    "commitAll": false
  }
}
