{
    "engines": {
        "node": "=22.13.0"
    },
    "name": "metal",
    "version": "0.4.0",
    "description": "Metal Server",
    "author": "Anis Megdiche",
    "license": "GPL-3.0-or-later",
    "main": "./build/index.js",
    "scripts": {
        "prod": "node ./build/index.js",
        "prod-ts": "ts-node ./src/index.ts",
        "dev": "nodemon --exec \"npm run dev-ts\" --watch src/**/*",
        "dev-ts": "ts-node-dev --inspect=0.0.0.0:9229 ./src/index.ts",
        "build": "tsc --watch",
        "test": "jest --testMatch \"**/__tests__/*.test.ts\"",
        "test-e2e": "jest --testMatch \"**/client/__tests__/**/*.js\"",
        "test-docker": "docker compose run --rm metal npx jest --testMatch \"**/__tests__/*.test.ts\" --watchAll",
        "prepare": "ts-patch install",
        "release": "standard-version",
        "release:dry": "standard-version --dry-run --skip.commit --skip.tag",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "lint": "eslint --fix src",
        "pretty": "dprint fmt src/**",
        "check": "npm run lint && npm run pretty",
        "dev-changelog": "git --no-pager log --since=\"2024-12-15\" --oneline --pretty=format:\"- %s\" > HISTORY.md",
        "dev-dep-circular": "madge --circular --image graph.svg .\\src\\index.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.896.0",
        "@azure/cosmos": "^4.5.1",
        "@azure/storage-blob": "^12.28.0",
        "@azure/storage-file-datalake": "^12.27.0",
        "@azure/storage-file-share": "^12.28.0",
        "@loxjs/url-join": "^1.0.2",
        "@synatic/noql": "^5.0.2",
        "alasql": "^4.6.6",
        "axios": "^1.12.2",
        "basic-ftp": "^5.0.5",
        "bcryptjs": "^3.0.2",
        "bytes": "^3.1.2",
        "chokidar": "^4.0.3",
        "chrono-node": "^2.8.0",
        "colorette": "^2.0.20",
        "cron": "^4.3.0",
        "dockerode": "^4.0.8",
        "dotenv": "^17.2.2",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "express-openapi-validator": "^5.6.0",
        "express-rate-limit": "^8.1.0",
        "fast-xml-parser": "^5.2.5",
        "file-type": "^21.0.0",
        "helmet": "^8.1.0",
        "js-sha512": "^0.9.0",
        "js-yaml": "^4.1.0",
        "jsonwebtoken": "^9.0.2",
        "load-esm": "^1.0.3",
        "lodash": "^4.17.21",
        "loglevel": "^1.9.2",
        "loglevel-plugin-prefix": "^0.8.4",
        "mime-types": "^3.0.1",
        "mongodb": "^6.20.0",
        "morgan": "^1.10.1",
        "mssql": "^11.0.1",
        "mysql2": "^3.14.1",
        "object-path": "^0.11.8",
        "openid-client": "^6.8.1",
        "papaparse": "^5.5.3",
        "pg": "^8.16.3",
        "response-time": "^2.3.4",
        "safe-stable-stringify": "^2.5.0",
        "soap": "^1.4.2",
        "swagger-ui-express": "^5.0.1",
        "ts-mixer": "^6.0.4",
        "typia": "^9.7.2"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-typescript": "^7.27.1",
        "@eslint/js": "^9.36.0",
        "@jest/globals": "^30.1.2",
        "@types/cron": "^2.4.3",
        "@types/dockerode": "^3.3.44",
        "@types/express": "^5.0.3",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonstream": "^0.8.33",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/lodash": "^4.17.20",
        "@types/mime-types": "^3.0.1",
        "@types/morgan": "^1.9.10",
        "@types/mssql": "^9.1.8",
        "@types/node": "^24.5.2",
        "@types/object-path": "^0.11.4",
        "@types/offscreencanvas": "^2019.7.3",
        "@types/papaparse": "^5.3.16",
        "@types/pg": "^8.15.5",
        "@types/response-time": "^2.3.9",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "babel-jest": "^30.1.2",
        "crc-32": "^1.2.2",
        "dprint": "^0.50.2",
        "eslint": "^9.36.0",
        "eslint-plugin-lodash": "^8.0.0",
        "eslint-plugin-security": "^3.0.1",
        "eslint-plugin-unused-imports": "^4.2.0",
        "eslint-plugin-you-dont-need-lodash-underscore": "^6.14.0",
        "form-data": "^4.0.4",
        "fs-extra": "^11.3.2",
        "globals": "^16.4.0",
        "jest": "^29.7.0",
        "madge": "^8.0.0",
        "nodemon": "^3.1.10",
        "standard-version": "^9.5.0",
        "ts-jest": "^29.4.4",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "ts-patch": "^3.3.0",
        "tslib": "^2.8.1",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.44.1"
    },
    "standard.options": {
        "ignore": [
            "node_modules/**",
            "build/**",
            "*.vscode*"
        ]
    },
    "standard-version": {
        "noVerify": true,
        "commitAll": false
    }
}
