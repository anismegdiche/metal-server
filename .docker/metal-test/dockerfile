## Docker testing image for Metal
FROM node:24.13.0-slim
LABEL org.opencontainers.image.authors="Anis Megdiche <anis.megdiche@gmail.com>"

# Update packages
RUN apt-get update && apt-get upgrade -y

# Create the app directory
WORKDIR /app

# Copy dependency and config files
COPY package.json ./
COPY tsconfig.json ./
COPY tsup.config.ts ./
COPY vitest* ./
COPY src ./src
COPY config ./config
COPY *.md ./

# Install dependencies
RUN npm install
RUN npm run prepare

# Start your app (you can change this to whatever you use to start the container)
CMD ["npm", "run", "test"]