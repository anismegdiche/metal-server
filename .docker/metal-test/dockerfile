## Docker testing image for Metal
FROM node:24.16.0-slim
LABEL org.opencontainers.image.authors="Anis Megdiche <anis.megdiche@gmail.com>"

# Update packages
RUN apt-get update && apt-get upgrade -y

# Create the app directory
WORKDIR /app

# Copy dependency manifests (monorepo layout, layer-cached)
COPY package.json yarn.lock .yarnrc.yml ./
COPY apps/*/package.json ./apps/
COPY packages/*/package.json ./packages/
COPY docs/package.json ./docs/

# Enable corepack (yarn)
RUN corepack enable

# Install dependencies
RUN yarn install

# Copy the rest of the monorepo
COPY . .

# Start your app (you can change this to whatever you use to start the container)
CMD ["yarn", "vitest", "run"]
