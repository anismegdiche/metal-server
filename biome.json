{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**/*.{ts,tsx,js,jsx,json}"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 1,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn",
				"noExtraBooleanCast": "error",
				"noStaticOnlyClass":"off"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"noUndeclaredVariables": "error",
				"noUnreachable": "error"
			},
			"style": {
				"useImportType": "warn",
				"useConsistentArrayType": "error",
				"useLiteralEnumMembers": "off"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noArrayIndexKey": "warn",
				"noConfusingVoidType": "off"
			},
			"nursery": {
				"useSortedClasses": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded",
			"bracketSpacing": true
		},
		"globals": [
			"vi",
			"describe",
			"it",
			"expect",
			"beforeEach",
			"afterEach",
			"beforeAll",
			"afterAll",
			"METHOD_COLOR_MAP",
			"PROVIDER_ICON_MAP",
			"SCHEMA_TYPE_BADGE",
			"STATUS_DOT_MAP",
			"STATUS_LABEL_MAP",
			"TYPE_ICON_MAP",
			"abortNavigation",
			"addRouteMiddleware",
			"callOnce",
			"cancelIdleCallback",
			"clearError",
			"clearNuxtData",
			"clearNuxtState",
			"computed",
			"createError",
			"createUseAsyncData",
			"createUseFetch",
			"customRef",
			"defineAppConfig",
			"defineAsyncComponent",
			"defineComponent",
			"defineLazyHydrationComponent",
			"defineLocale",
			"defineNuxtComponent",
			"defineNuxtLink",
			"defineNuxtPlugin",
			"defineNuxtRouteMiddleware",
			"definePageMeta",
			"definePayloadPlugin",
			"definePayloadReducer",
