{
    "compilerOptions": {
        "target": "ESNext",
        "module": "CommonJS",
        "moduleResolution": "node",
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./build",
        "allowSyntheticDefaultImports": true, // Typing support for this case
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "removeComments": false,
        "resolveJsonModule": false, // DO NOT CHANGE
        "inlineSourceMap": false,
        "inlineSources": true,
        "strictNullChecks": true,
        "types": ["node", "jest"],
        "typeRoots": [
            "./node_modules/@types",
            "./src/@types"
        ],
        "plugins": [
            {
                "transform": "typia/lib/transform"
            }
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules", 
        "**/node_modules/**",
        "__*/**/*",
        "docs/**/*"
    ],
    "typeRoots": [
        "./node_modules/@types",
        "./src/@types"
    ],
    "ts-node": {
        "files": true
    },
    "files": [
        "src/index.ts",
        "src/@types/express/index.d.ts",
        "src/@types/sql-tokenizer/index.d.ts"
    ],
}